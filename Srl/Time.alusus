import "Srl/Time";

@merge module Srl {
    @merge module Time {
        function getStringLocalDateTime (timestamp: ArchInt) => String {
            def time: DetailedTime;
            getDetailedLocalTime(timestamp~ptr, time~ptr);
            def offset: ArchInt = time.timezoneOffset;
            def sign: Char = '+';
            if offset < 0 {
                sign = '-';
                offset = 0 - offset;
            }
            def buf: array[Char, 100];
            String.assign(
                buf~ptr, "%04d-%02d-%02dT%02d:%02d:%02d%c%02d:%02d",
                time.year + 1900, time.month + 1, time.day, time.hour, time.minute, time.second,
                sign~cast[Int], (offset / 3600)~cast[Int], (offset % 3600 / 60)~cast[Int]
            );
            return String(buf~ptr);
        }

        function getStringUTCDateTime (timestamp: ArchInt) => String {
            def time: DetailedTime;
            getDetailedUTCTime(timestamp~ptr, time~ptr);
            def buf: array[Char, 100];
            String.assign(
                buf~ptr, "%04d-%02d-%02dT%02d:%02d:%02d+00:00",
                time.year + 1900, time.month + 1, time.day, time.hour, time.minute, time.second
            );
            return String(buf~ptr);
        }

        function getCurrentStringLocalDateTime () => String {
            return getStringLocalDateTime(getTimestamp(0));
        }
        function getCurrentStringUTCDateTime () => String {
            return getStringUTCDateTime(getTimestamp(0));
        }
    }
}
