import "Srl/String";
import "Apm";
Apm.importPackage("Alusus/Sle@0.2", "Srl/Net.alusus");
use Srl;

func test {
    def request: Net.Request(String("https://alusus.org/Examples/General/hello_world.alusus"));
    request.verbose = false;
    request.get();
    Console.print("Response from https://alusus.org/Examples/General/hello_world.alusus:\n%s", request.responseBody.buf);
}

test();
